# Copy this file to .env and fill it in. .env is git-ignored: never commit it.
#
# Only needed to talk to Flashpoint (designing, publishing or checking the survey).
# The site, the tests and the data build need no keys at all.

# Private key of the wallet Flashpoint bills, as a 0x-prefixed hex string.
# Each survey-agent call costs $0.50 in USDC on Base.
FLASHPOINT_WALLET_KEY=0xYOUR_WALLET_PRIVATE_KEY

# Only needed for the agent in agent/. The model that decides the agent's steps.
ANTHROPIC_API_KEY=sk-ant-YOUR_KEY
